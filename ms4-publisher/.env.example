POSTGRES_DB=ms4_publisher
POSTGRES_USER=rpc_user
POSTGRES_PASSWORD=rpc_pass
POSTGRES_HOST=ms4-postgres
POSTGRES_PORT=5432

MS1_URL=http://boca-scraper:3001
MS2_URL=http://generartabla:5002

SECRET_KEY=cambiar_en_produccion
DEBUG=True
ALLOWED_HOSTS=*

# ── Login con Google (OAuth2) ───────────────────────────────
# Crea las credenciales en https://console.cloud.google.com/apis/credentials
#   → Crear credenciales → ID de cliente OAuth → Aplicación web.
# GOOGLE_REDIRECT_URI debe coincidir EXACTO con la "URI de redireccionamiento autorizada".
#   Bajo nginx:  https://<dominio>/facebook-table/publisher/login/google/callback/
#   En Render (raiz):  https://<dominio>/login/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
